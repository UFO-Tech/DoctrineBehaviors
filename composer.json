{
    "name": "ufo-tech/doctrine-behaviors",
    "description": "Doctrine Behavior Traits for symfony 7+ and Doctrine DBAL 4+ and Doctrine ORM 3+",
    "type": "symfony-bundle",
    "keywords": [
        "behaviors",
        "doctrine",
        "timestampable",
        "translatable",
        "blameable",
        "softdeletable",
        "tree",
        "uuid"
    ],
    "homepage": "https://github.com/UFO-Tech/DoctrineBehaviors",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Maystrenko",
            "email": "ashterix69@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/common": "^3.3",
        "doctrine/persistence": "^4.0",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.7",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/cache": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/security-core": "^7.0|^8.0",
        "symfony/security-bundle": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/string": "^7.0|^8.0",
        "symfony/translation-contracts": "^2.4|^3.0|^4.0|^5.0",
        "nette/utils": "^4.0",
        "ramsey/uuid": "^4.2"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_pgsql": "*",
        "psr/log": "^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6",
        "symplify/easy-coding-standard": "^13.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "symplify/phpstan-rules": "^14.12",
        "phpstan/extension-installer": "^1.4",
        "colinodell/psr-testlogger": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Ufo\\DoctrineBehaviors\\": "src",
            "Ufo\\DoctrineBehaviors\\PHPStan\\": "utils/phpstan-behaviors/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ufo\\DoctrineBehaviors\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "phpstan-extension.neon"
            ]
        },
        "symfony": {
            "endpoint": [
                "https://api.github.com/repos/ufo-tech/recipes/contents/index.json?ref=main"
            ]
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd"
        },
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "phpstan": "vendor/bin/phpstan analyse --ansi --error-format symplify"
    }
}
